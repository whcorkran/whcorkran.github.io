{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Local Server and Open in Firefox",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "postDebugTask": "open-localhost"
    }
  ]
}
